{
  "name": "nyu-club-campus-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tech NYU assistant with a campus map and permission-aware knowledge backend",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.google scripts/dev.mjs",
    "dev:web": "node --env-file-if-exists=.env --env-file-if-exists=.env.google node_modules/vite/bin/vite.js",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "node --env-file-if-exists=.env --env-file-if-exists=.env.google --watch server/index.js",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/index.js",
    "build:api": "node scripts/check-api.mjs",
    "test:assistant": "node --test tests/assistant.test.mjs tests/backend-provider.test.mjs",
    "worker:discord": "node --env-file-if-exists=.env server/discord/event-cli.js serve",
    "test:discord": "node --test tests/discord*.test.mjs",
    "discord:preflight": "node --env-file-if-exists=.env server/discord/cli.js preflight",
    "discord:register": "node --env-file-if-exists=.env server/discord/cli.js register",
    "deploy:discord:prepare": "node scripts/prepare-discord-deploy.mjs",
    "deploy:gmail:prepare": "node scripts/prepare-gmail-deploy.mjs",
    "discord:policy": "node --env-file-if-exists=.env server/discord/cli.js policy",
    "discord:discover": "node --env-file-if-exists=.env server/discord/cli.js discover",
    "google:connect": "node --env-file-if-exists=.env scripts/google-connect.mjs",
    "test:miro": "node --test tests/miro-*.test.mjs tests/update-agent-mcp.test.mjs",
    "test:schema-cleanup": "node --test tests/schema-cleanup*.test.mjs",
    "test:discord:catalogue": "node --test tests/discord-catalogue*.test.mjs",
    "worker:agent": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/automation/cli.js serve",
    "agent:tick": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/automation/cli.js once",
    "gmail:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/google/subscription-cli.js status",
    "gmail:watch": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/google/subscription-cli.js watch",
    "gmail:sync": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/google/subscription-cli.js sync",
    "worker:gmail": "node --env-file-if-exists=.env --env-file-if-exists=.env.google server/google/subscription-cli.js serve",
    "test:agent-automation": "node --test tests/agent-input-cache-sql.test.mjs tests/agent-automation*.test.mjs tests/gmail-subscription.test.mjs tests/calendar-tools.test.mjs tests/update-agent-calendar.test.mjs tests/map-contracts.test.mjs tests/update-agent-prompt.test.mjs tests/map-event-tools.test.mjs tests/update-agent-map.test.mjs",
    "test:map-roster": "node --test tests/map-schema.test.mjs tests/map-roster.test.mjs tests/map-building-write-scope.test.mjs tests/map-presence-labels-sql.test.mjs",
    "map:roster": "node --env-file-if-exists=.env scripts/map-roster.mjs",
    "test:map-presence": "node --test tests/map-presence.test.mjs",
    "test:update-agent-prompt": "node --test tests/map-contracts.test.mjs tests/update-agent-prompt.test.mjs",
    "test:map-events": "node --test tests/map-events-sql.test.mjs tests/events-relationships-sql.test.mjs tests/events-service.test.mjs tests/map-presence.test.mjs tests/map-source-access.test.mjs tests/map-event-tools.test.mjs tests/event-types-sql.test.mjs",
    "map:debug": "node --env-file-if-exists=.env scripts/map-debug-presence.mjs",
    "miro:connect": "node --env-file-if-exists=.env scripts/miro-connect.mjs",
    "start:web": "node server/web.js",
    "deploy:web:prepare": "node scripts/prepare-runtime-deploy.mjs web",
    "deploy:agent:prepare": "node scripts/prepare-runtime-deploy.mjs agent-worker",
    "test:discord:chat": "node --test tests/discord-chat*.test.mjs tests/chat-runner.test.mjs tests/chat-request-context.test.mjs",
    "gmail:enrichment:status": "node --env-file-if-exists=.env server/gmail-enrichment/cli.js status",
    "gmail:enrichment:once": "node --env-file-if-exists=.env server/gmail-enrichment/cli.js once",
    "worker:gmail:enrichment": "node --env-file-if-exists=.env server/gmail-enrichment/cli.js scheduled",
    "deploy:enrichment:prepare": "node scripts/prepare-gmail-enrichment-deploy.mjs",
    "gmail:enrichment:drain": "node --env-file-if-exists=.env server/gmail-enrichment/cli.js drain"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@discordjs/ws": "2.0.4",
    "@hono/node-server": "^2.1.4",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "clipper-lib": "^6.4.2",
    "google-auth-library": "^11.3.0",
    "hono": "^4.13.13",
    "markdown-it": "^15.0.3",
    "saxes": "^6.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.0",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
