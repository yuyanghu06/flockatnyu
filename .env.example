# Server-only settings. Copy to ignored .env; never prefix secrets with VITE_.
NODE_ENV=development
PORT=3001
# Production binds 0.0.0.0; development binds 127.0.0.1.
# HOST=0.0.0.0

LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
# API root, not a complete endpoint. Anthropic is also supported.
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_MS=120000
# Four read-only calls per request; Miro may use four planning rounds.
LLM_RETRIEVAL_TOOLS_ENABLED=true

SUPABASE_URL=https://jssehnrmqhstcrtxulpa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Shared source scope for every assistant reader; no membership rows required.
ASSISTANT_ALLOWED_SOURCE_IDS=
# Backward-compatible local alias (used if the shared setting is empty).
DEV_ALLOWED_SOURCE_IDS=
DEV_ADMIN_ENABLED=false

# Existing Discord bot; live reads fetch channel/time windows directly into RAM.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_EVENTS_ENABLED=false
DISCORD_LIVE_READ_ENABLED=false
# Explicit loopback capability; production API access remains separately configured.
DEV_LIVE_DISCORD_ENABLED=false
DISCORD_DISCOVERY_MAX_PAGES=500
DISCORD_DISCOVERY_MAX_CHANNELS=2000
DISCORD_DISCOVERY_MAX_RUNTIME_MS=900000
DISCORD_DISCOVERY_PAGE_SIZE=100

# Discord content is read live. No scheduled summaries or stored embeddings.
# Larger requested windows may be summarized in RAM (up to12calls/$0.10 per request),
# using the supported configured model. No summary/usage records are persisted.

# Gmail/Drive read-only OAuth. An API key cannot authorize private account data.
# Run npm run google:connect after supplying client settings and expected email.
# Consent saves refresh credentials in ignored .env.google with owner-only access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EXPECTED_ACCOUNT_EMAIL=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
GOOGLE_REFRESH_TOKEN=
DEV_GOOGLE_ENABLED=false

# M27: server-only read-only Miro board sync. Use an app's non-expiring token;
# automatic OAuth refresh is not implemented. Never put real values in this file.
MIRO_SYNC_ENABLED=false
MIRO_ACCESS_TOKEN=
# Comma-separated exact board IDs or https://miro.com/app/board/ID/ URLs.
MIRO_BOARD_IDS=
# Optional restriction, checked against each board's actual team.
MIRO_TEAM_ID=
# Defaults: bounded20min run,32MiB total and20000 objects per collection.
# MIRO_MAX_RUN_MS=1200000
# MIRO_MAX_BYTES=33554432
# MIRO_MAX_ITEMS=20000
# The API's Miro tools require the board source ID in the trusted backend
# ASSISTANT_ALLOWED_SOURCE_IDS setting; no per-person membership records are used.

# M34: opt-in cache-driven agent. Requires local migrations018/019 applied once.
# The cache stays uuid/raw_response;019 holds only leases/dedup/receipt metadata.
AGENT_AUTOMATION_ENABLED=false
AGENT_AUTOMATION_TIMEZONE=America/New_York
AGENT_AUTOMATION_MIN_EVENTS=5
AGENT_AUTOMATION_MAX_AGE_SECONDS=300
AGENT_AUTOMATION_COOLDOWN_SECONDS=60
AGENT_AUTOMATION_POLL_MS=5000
# Trusted server-local JS module exporting createAutomationAdapters; never a URL
# supplied by a source message. See docs/agent-automation.md.
AGENT_AUTOMATION_ADAPTER_MODULE=

# M35: Gmail Pub/Sub notifications. Project provided by the user: techflock.
# A new, explicit source UUID must also appear in ASSISTANT_ALLOWED_SOURCE_IDS.
# No Gmail send/modify or additional Google OAuth scopes are requested.
GMAIL_EVENTS_ENABLED=false
AGENT_GMAIL_SOURCE_ID=
GOOGLE_PUBSUB_PROJECT_ID=techflock
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
# Exact public HTTPS callback/audience; handler path is /webhooks/gmail.
GOOGLE_PUBSUB_AUDIENCE=
# Exact Pub/Sub push OIDC service-account email, checked on every notification.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=
