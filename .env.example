# Server-only settings. Copy to .env; never use a VITE_ prefix for secrets.
NODE_ENV=development
PORT=3001
# Production binds 0.0.0.0 by default; development always binds 127.0.0.1.
# HOST=0.0.0.0

# Supported protocols: openai-compatible or anthropic. No default model or key.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
# API root, not a complete /chat/completions or /messages endpoint.
LLM_BASE_URL=https://api.openai.com/v1
# For Anthropic: LLM_PROVIDER=anthropic and LLM_BASE_URL=https://api.anthropic.com/v1
LLM_TIMEOUT_MS=30000

# Optional knowledge store. These are distinct from developer MCP OAuth.
SUPABASE_URL=https://jssehnrmqhstcrtxulpa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Empty means no access to stored club knowledge, even with a database key.
# Explicit source UUIDs for the local-development principal only.
# Source and document membership grants must also include local-development.
DEV_ALLOWED_SOURCE_IDS=
