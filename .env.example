# Server-only settings. Copy to .env; never use a VITE_ prefix for secrets.
NODE_ENV=development
PORT=3001
# Production binds 0.0.0.0 by default; development always binds 127.0.0.1.
# HOST=0.0.0.0

# Supported protocols: openai-compatible or anthropic. No default model or key.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
# API root, not a complete /chat/completions or /messages endpoint.
LLM_BASE_URL=https://api.openai.com/v1
# For Anthropic: LLM_PROVIDER=anthropic and LLM_BASE_URL=https://api.anthropic.com/v1
LLM_TIMEOUT_MS=30000

# Optional knowledge store. These are distinct from developer MCP OAuth.
SUPABASE_URL=https://jssehnrmqhstcrtxulpa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Empty means no access to stored club knowledge, even with a database key.
# Explicit source UUIDs for the local-development principal only.
# Source and document membership grants must also include local-development.
DEV_ALLOWED_SOURCE_IDS=

# Development administrator access is opt-in and also needs a database admin grant.
DEV_ADMIN_ENABLED=false
# Lets the selected chat model choose up to two scoped Discord retrieval calls.
# false uses the bounded text-search fallback and saves one model request.
LLM_RETRIEVAL_TOOLS_ENABLED=true

# Separate Discord archive bot, not the existing calendar reminder bot.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Explicit database admin identity for CLI channel registration (UUID preferred).
# Must be separately provisioned in discord_admin_members; grants no archive read access.
DISCORD_OPERATOR_MEMBER_ID=
# Registration CLI defaults each selected channel to full available history since Discord epoch.
# Existing per-channel cutoffs take precedence over this generic worker fallback.
DISCORD_BACKFILL_FROM=2026-01-01T00:00:00-05:00
DISCORD_MAX_PAGES_PER_CHANNEL=100
DISCORD_MAX_MESSAGES_PER_RUN=10000
DISCORD_MAX_RUNTIME_MS=900000

# Optional embeddings. Default text/date/author search needs no embedding key.
EMBEDDING_ENABLED=false
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_MAX_INPUTS_PER_RUN=100

# Discovery checkpoints/policy live in Supabase; exclusions inherit descendants.
DISCORD_DISCOVERY_MAX_PAGES=500
DISCORD_DISCOVERY_MAX_CHANNELS=2000
DISCORD_DISCOVERY_MAX_RUNTIME_MS=900000
DISCORD_DISCOVERY_PAGE_SIZE=100

# Text-only Luna weekly/monthly retention; same server-only credentials above.
# Set LLM_MODEL=gpt-6-luna for these separately invoked summary commands.
# No daily summaries. Verified weekly/monthly publication replaces consumed raw.
# Monday/1st at08:00 New York; scheduled gate handles DST.
# No embeddings, image inputs, tools or linked-document fetching.
DISCORD_SUMMARY_CONCURRENCY=4
DISCORD_SUMMARY_MAX_GROUPS=25
DISCORD_SUMMARY_MAX_REQUESTS=100
DISCORD_SUMMARY_MAX_RUNTIME_MS=600000
DISCORD_SUMMARY_OPERATION_MAX_USD=5
DISCORD_SUMMARY_RUN_MAX_USD=1
