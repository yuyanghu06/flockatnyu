# Server-only settings. Copy to ignored .env; never prefix secrets with VITE_.
NODE_ENV=development
PORT=3001
# Defaults: production 0.0.0.0; development 127.0.0.1.
# Railway web needs HOST=:: for private IPv6 plus public IPv4 traffic.
# HOST=::

LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
# API root, not a complete endpoint. Anthropic is also supported.
LLM_BASE_URL=https://api.openai.com/v1
# Optional ordered fallback list. Blank uses the four legacy LLM_* values above.
# API base URL and key are required; provider/model may inherit the values above.
# Put real keys only in private .env / hosting variables. Never use VITE_ prefixes.
LLM_PROVIDERS_JSON=
# Example (one line; replace keys/URLs and set each provider's model when needed):
# LLM_PROVIDERS_JSON='[{"baseUrl":"https://api.openai.com/v1","apiKey":"REPLACE_PRIMARY_KEY"},{"baseUrl":"https://backup-one.example/v1","apiKey":"REPLACE_SECOND_KEY","model":"backup-model"},{"baseUrl":"https://backup-two.example/v1","apiKey":"REPLACE_THIRD_KEY","model":"another-model"}]'
LLM_TIMEOUT_MS=120000
# Overall chat request includes paced source reads and the final answer.
ASSISTANT_REQUEST_TIMEOUT_MS=420000
# Shared chat permits 30 total tool calls / 30 planning rounds, at most 2 per round.
LLM_RETRIEVAL_TOOLS_ENABLED=true

SUPABASE_URL=https://jssehnrmqhstcrtxulpa.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Explicit source grants for non-Discord integrations; no membership rows required.
# Discord grants come from the current published guild catalogue and blacklist.
ASSISTANT_ALLOWED_SOURCE_IDS=
# Backward-compatible local alias (used if the shared setting is empty).
DEV_ALLOWED_SOURCE_IDS=
DEV_ADMIN_ENABLED=false

# Existing Discord bot; live reads fetch channel/time windows directly into RAM.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_EVENTS_ENABLED=false
# Eboard bot mentions and reply follow-ups; existing blacklist still applies.
# Enable on both web and discord-events. Keep the same private random secret
# (32+ characters) on those two services; never expose it to browser builds.
DISCORD_CHAT_ENABLED=false
# Full 20-minute runs require the web service Railway private hostname/port.
# Use the deployed web PORT; the example below assumes PORT=3000 on Railway.
DISCORD_CHAT_API_ORIGIN=http://web.railway.internal:3000
DISCORD_CHAT_BRIDGE_SECRET=
# Explicit capacity on both web and discord-events; code fallbacks remain 3/1.
DISCORD_CHAT_MAX_CONCURRENT=10
DISCORD_CHAT_PER_USER_CONCURRENT=5
DISCORD_CHAT_REQUESTS_PER_USER_HOUR=20
# Overall Discord deadline on both services: 20-minute default/maximum.
# Explicit shorter overrides remain supported; website/provider limits are separate.
DISCORD_CHAT_TIMEOUT_MS=1200000

DISCORD_LIVE_READ_ENABLED=false
# Explicit loopback capability; production API access remains separately configured.
DEV_LIVE_DISCORD_ENABLED=false
DISCORD_DISCOVERY_MAX_PAGES=500
DISCORD_DISCOVERY_MAX_CHANNELS=2000
DISCORD_DISCOVERY_MAX_RUNTIME_MS=900000
# Shared per-process metadata/content request spacing; default750ms, min500ms.
DISCORD_REQUEST_INTERVAL_MS=750
DISCORD_LIVE_MAX_RUNTIME_MS=120000
DISCORD_DISCOVERY_PAGE_SIZE=100

# Discord content is read live. No scheduled summaries or stored embeddings.
# Larger requested windows may be summarized in RAM (up to12calls/$0.10 per request),
# using the supported configured model. No summary/usage records are persisted.

# Gmail/Drive read-only OAuth. An API key cannot authorize private account data.
# Run npm run google:connect after supplying client settings and expected email.
# Consent saves refresh credentials in ignored .env.google with owner-only access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_EXPECTED_ACCOUNT_EMAIL=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/oauth2callback
GOOGLE_REFRESH_TOKEN=
# Website-only plain-text Gmail sending; requires separately authorized gmail.send.
GMAIL_SEND_ENABLED=false
# Private random secret, at least 32 characters. Keep stable; never commit a value.
GMAIL_SEND_RECEIPT_KEY=
DEV_GOOGLE_ENABLED=false

# Live Miro MCP for both chat and update agents. No board snapshot worker/table.
# Run npm run miro:connect; credentials stay in ignored0600 .miro-mcp-auth.json.
MIRO_BOARD_IDS=
MIRO_TEAM_ID=
# Local default: private app OAuth JSON. On Railway mount a persistent writable
# volume for rotating refresh tokens; desktop Codex OAuth is separate.
# MIRO_MCP_AUTH_FILE=/data/miro-mcp-auth.json
# Alternative service-secret bootstrap:
# MIRO_MCP_CLIENT_ID=
# MIRO_MCP_CLIENT_SECRET=
# MIRO_MCP_REFRESH_TOKEN=
# MIRO_MCP_PERSIST_AUTH=true
# Short-lived static tokens are supported but need operator renewal:
# MIRO_MCP_ACCESS_TOKEN=
# MIRO_MCP_REQUEST_TIMEOUT_MS=60000
# MIRO_MCP_MAX_RESPONSE_BYTES=8388608
# Shared service-only daily budget defaults on when NODE_ENV=production.
# Metadata only:80 local calls/day,48 background,12 per600s session,6h cadence.
# Requires the existing Supabase service-role subscription state RPCs.
# MIRO_MCP_BUDGET_ENABLED=true
# Board source UUIDs must remain in ASSISTANT_ALLOWED_SOURCE_IDS.

# M34: opt-in cache-driven agent. Requires local migrations018/019 applied once.
# The cache stays uuid/raw_response;019 holds only leases/dedup/receipt metadata.
AGENT_AUTOMATION_ENABLED=false
# Server-only key for planner start/status routes; 32–512 URL-safe characters.
# Send Authorization: Bearer <key>. Website cookies do not authorize these routes.
PLANNER_API_KEY=
AGENT_AUTOMATION_TIMEZONE=America/New_York
AGENT_AUTOMATION_MIN_EVENTS=30
AGENT_AUTOMATION_MAX_AGE_SECONDS=1800
AGENT_AUTOMATION_COOLDOWN_SECONDS=60
AGENT_AUTOMATION_POLL_MS=5000
AGENT_AUTOMATION_MAX_ROUNDS=16
AGENT_AUTOMATION_MAX_CALLS=64
AGENT_AUTOMATION_MAX_RUN_MS=180000
# Up to600000ms for slower paced source checks; deployed worker uses5inputs/600000ms.
# Optional trusted server-local adapter override. Empty uses bundled Miro/Calendar adapters.
# Never supplied by source messages; see docs/agent-automation.md.
AGENT_AUTOMATION_ADAPTER_MODULE=

# M35: Gmail Pub/Sub notifications. Project provided by the user: techflock.
# A new, explicit source UUID must also appear in ASSISTANT_ALLOWED_SOURCE_IDS.
# No Gmail send/modify or additional Google OAuth scopes are requested.
GMAIL_EVENTS_ENABLED=false
AGENT_GMAIL_SOURCE_ID=
## Stable google_calendar knowledge_sources UUID for the configured club calendar;
## include this exact UUID in ASSISTANT_ALLOWED_SOURCE_IDS for Calendar-to-map writes.
AGENT_CALENDAR_SOURCE_ID=
GOOGLE_PUBSUB_PROJECT_ID=techflock
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_SUBSCRIPTION=
# Exact public HTTPS callback/audience; handler path is /webhooks/gmail.
GOOGLE_PUBSUB_AUDIENCE=
# Exact Pub/Sub push OIDC service-account email, checked on every notification.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT=

# Update agent Calendar target: explicit Calendar ID, never "primary".
# Run google:connect -- --force --calendar for additional Calendar consent.
# OAuth event scope covers the account; runtime tools pin writes to this ID.
GOOGLE_CALENDAR_ID=

# Private Railway website. Secrets live only in hosting environment variables.
# Production web requires a fixed HTTPS origin, password >=12 chars, signing secret >=32.
PUBLIC_ORIGIN=
# Optional comma-separated exact HTTPS login aliases; PUBLIC_ORIGIN remains included.
SITE_ALLOWED_ORIGINS=
SITE_ACCESS_PASSWORD=
SITE_SESSION_SECRET=
SITE_SESSION_TTL_SECONDS=2592000
SITE_GOOGLE_ENABLED=false
SITE_DISCORD_ENABLED=false
# Web is the sole OAuth owner with /data persistent private auth file.
# MIRO_MCP_AUTH_FILE=/data/miro-auth.json
# MIRO_MCP_PERSIST_AUTH=true
MIRO_TOKEN_BROKER_SECRET=
# Worker uses broker only, without any refresh token/client/auth-file settings.
# MIRO_MCP_TOKEN_BROKER_URL=https://YOUR-WEB-DOMAIN/internal/miro/token

# Private operational model audit: production always requires durable logging.
# Development recording is opt-in; never put credentials into audit output.
MODEL_AUDIT_ENABLED=false
MODEL_AUDIT_REQUIRED=false
MODEL_AUDIT_TIMEOUT_MS=3000

# Attio CRM (server only; never use VITE_). All access is opt-in.
ATTIO_API_TOKEN=
# Separate UUID identifying this CRM source; also add it to ASSISTANT_ALLOWED_SOURCE_IDS.
ATTIO_SOURCE_ID=
# Explicit comma-separated object slugs, e.g. people,companies; blank grants none.
ATTIO_ALLOWED_OBJECTS=
ATTIO_WRITES_ENABLED=false
ATTIO_TIMEOUT_MS=60000

# Staged worker: initial Calendar updates -> deterministic projection -> <=10 follow-up turns.
# Enable only after forward039/040/041 and both pinned calendar access checks.
AGENT_AUTOMATION_STAGED_ENABLED=false
AGENT_AUTOMATION_FOLLOWUP_ROUNDS=10
AGENT_AUTOMATION_MAX_FOLLOWUP_CALLS=64
GOOGLE_MEMBER_PLANS_CALENDAR_ID=
# Distinct UUID explicitly added to ASSISTANT_ALLOWED_SOURCE_IDS.
AGENT_MEMBER_PLANS_SOURCE_ID=
# Private random >=32-character key; same stable value on worker/web, never commit.
AGENT_MEMBER_PLANS_SIGNING_KEY=

# Treg people-search imports (server only; never use VITE_).
# Prefer an org-scoped token; TREG_ORG is optional for personal tokens.
TREG_TOKEN=
TREG_ORG=
# Per-search ceiling in USD, >0 and <=1. No automatic retries or waterfall.
TREG_MAX_COST_USD=0.10
# Private full-call JSONL logs: request, bounded response and import outcome.
# Default: .local/treg-calls in development; /data/treg-calls in production.
# Keep this directory private/on persistent storage. Own logs expire after seven days.
TREG_CALL_LOG_DIR=

# Separate Contacts-cache enrichment service (opt-in; does not read Gmail).
# Intake source/account are service configuration, not per-row cache provenance.
GMAIL_ENRICHMENT_ENABLED=false
# Daily service only: Tomba first, Apollo second; 1 or 2 total providers.
GMAIL_ENRICHMENT_MAX_PROVIDERS=2
GMAIL_ENRICHMENT_ACCOUNT=
GMAIL_ENRICHMENT_SOURCE_IDS=
# One email at a time; hard ceiling 50 per batch, never 50 concurrent calls.
GMAIL_ENRICHMENT_BATCH_SIZE=50
# Legacy lower limits can reduce a batch; they cannot bypass the hard ceiling.
GMAIL_ENRICHMENT_MAX_REQUESTS=50
GMAIL_ENRICHMENT_MAX_ITEMS=50
# Daily scheduled runs drain batches until empty or a safe stop; absolute loop guard.
GMAIL_ENRICHMENT_MAX_DRAIN_CYCLES=1000
# Pause between successful daily batches; also the development serve interval.
GMAIL_ENRICHMENT_POLL_MS=5000
GMAIL_ENRICHMENT_LEASE_SECONDS=120
GMAIL_ENRICHMENT_MAX_CYCLE_COST_USD=0.50
GMAIL_ENRICHMENT_MAX_DAILY_COST_USD=1.00
